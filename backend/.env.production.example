# ============================================================
#  BACKEND — PRODUCCIÓN (vinback.artemisnet.cloud)
#  Copia estas variables en la app de PRODUCCIÓN en Dokploy.
#  NO reutilices secretos entre prod y testing.
# ============================================================

PORT=3000
NODE_ENV=production

# Base de datos de PRODUCCIÓN (instancia/cluster propio)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/VinApp?schema=public"

# Secretos (genera valores largos y aleatorios, distintos por entorno)
JWT_SECRET="CAMBIAR_prod_jwt_secreto_largo"
HMAC_SECRET="CAMBIAR_prod_hmac_secreto_largo"

# API key del maestro RF24 (OBLIGATORIA: sin ella el maestro recibe 503)
ARDUINO_API_KEY="CAMBIAR_prod_api_key_maestro"

# CORS: orígenes del front de PRODUCCIÓN (coma-separados). Requerido fuera de dev.
CORS_ALLOWED_ORIGINS="https://vinapp.artemisnet.cloud"

# Cookies de auth — claves para que la app Android mantenga la sesión:
#  - SameSite=None + Secure permiten enviarlas desde el origen Capacitor.
#  - Domain compartido para que valgan en vinapp/vinback.
AUTH_COOKIE_DOMAIN=".artemisnet.cloud"
AUTH_COOKIE_SAMESITE="none"
AUTH_COOKIE_SECURE="true"

# Rate limit de creación de cuentas por IP
AUTH_REGISTER_RATE_LIMIT_MAX=5

# Swagger protegido en prod (Basic Auth); define usuario/clave o IPs permitidas
SWAGGER_DOCS_PROTECT=true
SWAGGER_DOCS_BASIC_USER="admin"
SWAGGER_DOCS_BASIC_PASS="CAMBIAR"

# Seed: tras el PRIMER despliegue, poner en false para no re-sembrar en cada deploy
RUN_SEED=false

ENABLE_HEARTBEAT=true
HEARTBEAT_INTERVAL_MS=60000

# Email (OAuth2 Gmail)
GOOGLE_EMAIL=
GOOGLE_CLIENT_ID_EMAIL=
GOOGLE_CLIENT_SECRET_EMAIL=
GMAIL_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI_EMAIL=
CORREO_ADMINISTRACION=

# Google Sign-In (verificación de id_token)
GOOGLE_CLIENT_ID=

# Notificaciones: servicio notifier (app aparte en Dokploy, ver notifier/README.md)
NOTIFIER_URL=http://vinapp-notifier-prod:4000
NOTIFIER_API_KEY=
NOTIFIER_TIMEOUT_MS=2000

# Telegram (SOLO modo legado: déjalo vacío cuando uses el notifier; los tokens
# van en las variables del notifier)
TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_PUBLIC_CHAT_ID=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Contraseñas del seed inicial (initialSeed). Define valores propios.
SEED_MASTER_PASSWORD=cambia_esta_contrasena_maestra
SEED_ADMIN_PASSWORD=cambia_esta_contrasena_admin
SEED_CLIENT_PASSWORD=cambia_esta_contrasena_cliente
