PORT=3000
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/VinApp?schema=public"
JWT_SECRET="clave_super_secreta"
HMAC_SECRET="cambiar_en_produccion_valor_super_secreto_aleatorio"

MAESTRO_IP=10.0.0.X
MAESTRO_PORT=80
# REQUERIDA: sin esta variable, los endpoints del maestro (failure/recovery/
# health/map) rechazan toda petición (fail-closed). Usa un valor largo y aleatorio.
ARDUINO_API_KEY=clavesupersecreta
ENABLE_HEARTBEAT=false
HEARTBEAT_INTERVAL_MS=60000

# Límite de creación de cuentas por IP (ventana = AUTH_RATE_LIMIT_WINDOW_MS)
AUTH_REGISTER_RATE_LIMIT_MAX=5

# Servicio de notificaciones (carpeta notifier/). Con NOTIFIER_URL definido, el
# backend le encola los mensajes y los tokens de Telegram van solo en el notifier.
# Si queda vacío, el backend envía directo a Telegram con las variables TELEGRAM_*
# de abajo (modo legado).
NOTIFIER_URL=http://localhost:4000
NOTIFIER_API_KEY=
NOTIFIER_TIMEOUT_MS=2000

# Telegram (SOLO modo legado, sin NOTIFIER_URL)
# Telegram público: cambios de conectividad y alarma
TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_PUBLIC_CHAT_ID=

# Telegram administración: conectividad, alarma y habilitación del PINE
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Contraseñas del seed inicial (initialSeed). Define valores propios.
SEED_MASTER_PASSWORD=cambia_esta_contrasena_maestra
SEED_ADMIN_PASSWORD=cambia_esta_contrasena_admin
SEED_CLIENT_PASSWORD=cambia_esta_contrasena_cliente
