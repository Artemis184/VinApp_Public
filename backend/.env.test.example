# ============================================================
#  BACKEND — TESTING / STAGING (testvinback.artemisnet.cloud)
#  Copia estas variables en la app de TESTING en Dokploy.
#  Base de datos y secretos SEPARADOS de producción.
# ============================================================

PORT=3000
# Se ejecuta como "production" (no es entorno dev); lo que cambia es el resto.
NODE_ENV=production

# Base de datos de TESTING (distinta a la de prod)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/VinApp_test?schema=public"

# Secretos propios de testing (no los de prod)
JWT_SECRET="CAMBIAR_test_jwt_secreto_largo"
HMAC_SECRET="CAMBIAR_test_hmac_secreto_largo"

ARDUINO_API_KEY="CAMBIAR_test_api_key_maestro"

# CORS: orígenes del front de TESTING
CORS_ALLOWED_ORIGINS="https://testvinapp.artemisnet.cloud"

# Cookies (mismo esquema que prod; el domain compartido también sirve a test*)
AUTH_COOKIE_DOMAIN=".artemisnet.cloud"
AUTH_COOKIE_SAMESITE="none"
AUTH_COOKIE_SECURE="true"

AUTH_REGISTER_RATE_LIMIT_MAX=20

# En testing puedes dejar Swagger abierto para depurar
SWAGGER_DOCS_PROTECT=false

# En testing sí conviene sembrar datos de prueba
RUN_SEED=true

# El heartbeat suele ir apagado en testing para no spamear al maestro real
ENABLE_HEARTBEAT=false
HEARTBEAT_INTERVAL_MS=60000

GOOGLE_EMAIL=
GOOGLE_CLIENT_ID_EMAIL=
GOOGLE_CLIENT_SECRET_EMAIL=
GMAIL_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI_EMAIL=
CORREO_ADMINISTRACION=

GOOGLE_CLIENT_ID=

# Notificaciones: servicio notifier de testing (ver notifier/README.md)
NOTIFIER_URL=http://vinapp-notifier-test:4000
NOTIFIER_API_KEY=
NOTIFIER_TIMEOUT_MS=2000

# Telegram (SOLO modo legado: déjalo vacío cuando uses el notifier)
TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_PUBLIC_CHAT_ID=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Contraseñas del seed inicial (initialSeed). Define valores propios.
SEED_MASTER_PASSWORD=cambia_esta_contrasena_maestra
SEED_ADMIN_PASSWORD=cambia_esta_contrasena_admin
SEED_CLIENT_PASSWORD=cambia_esta_contrasena_cliente
