{
  "name": "vinculacion",
  "version": "1.0.0",
  "description": "Backend del proyecto de Vinculación desarrollado con Express, Prisma y TypeScript",
  "keywords": [
    "vinculacion",
    "backend",
    "express",
    "prisma",
    "typescript"
  ],
  "author": "ArtemisNet",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "scripts": {
    "docs": "tsx swagger.ts",
    "dev": "npm run docs && tsx watch src/index.ts",
    "build": "npm run docs && tsc && npm run copy:templates && npm run copy:templates:password && npm run copy:swagger",
    "copy:swagger": "copyfiles swagger-output.json dist/",
    "copy:templates": "copyfiles -u 3 \"src/Modules/email/templates/**/*\" dist/src/Modules/email/",
    "copy:templates:password": "copyfiles -u 3 \"src/Modules/password-recovery/templates/**/*\" dist/src/Modules/password-recovery/",
    "start": "node dist/src/index.js",
    "seed:prod": "node dist/prisma/seed.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "chokidar": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "format": "^0.2.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^8.0.6",
    "readdirp": "^5.0.0",
    "socket.io": "^4.8.3",
    "swagger-autogen": "^2.9.2",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.7",
    "@types/node": "^24.10.9",
    "@types/nodemailer": "^6.4.21",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "copyfiles": "^1.0.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "prisma": "^6.12.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  }
}
