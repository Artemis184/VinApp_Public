PORT=4000

# REQUERIDA: el backend la envía en el header x-api-key. Sin ella el servicio
# no arranca (fail-closed). Usa un valor largo y aleatorio, distinto por entorno:
#   openssl rand -hex 32
NOTIFIER_API_KEY=

# Telegram público: cambios de conectividad y alarma
TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_PUBLIC_CHAT_ID=

# Telegram administración: conectividad, alarma y habilitación del PINE
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Cola y reintentos (opcionales, estos son los valores por defecto) ---
# Máximo de mensajes pendientes en memoria; al llenarse responde 503.
QUEUE_MAX_SIZE=500
# Intentos totales por mensaje (1 envío + reintentos).
MAX_ATTEMPTS=5
# Espera base del backoff exponencial entre reintentos (ms).
RETRY_BASE_MS=2000
# Separación mínima entre envíos (ms). Telegram limita ~1 msg/s por chat.
SEND_INTERVAL_MS=1100
# Timeout de cada llamada a la API de Telegram (ms).
TELEGRAM_TIMEOUT_MS=5000
# Tiempo máximo para vaciar la cola al recibir SIGTERM (ms).
SHUTDOWN_DRAIN_MS=8000
